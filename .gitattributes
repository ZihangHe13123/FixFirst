# Keep published captures and hashes byte-for-byte on every checkout. In particular,
# CSV records and captured terminal output may intentionally contain CRLF or CR.
* -text

# Authored source is LF even when core.autocrlf is enabled.
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
SystemCode/src/fixfirst/templates/* text eol=lf

# Generated reports preserve whitespace inside captured command text.
SystemCode/examples/demo/*.html -whitespace
SystemCode/examples/execution-demo/*.html -whitespace
SystemCode/examples/dependency-demo/*.html -whitespace
SystemCode/examples/historical-regressions/**/*.html -whitespace

# Windows launchers need CRLF line endings.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Preserve whitespace in the captured HTML export used as delivery evidence.
SystemCode/docs/freeze/validation-20261001/entry-checks/shared.html -whitespace
